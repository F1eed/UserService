{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Infrastructure": {
    "Persistence": {
      "Mongo": {
        "Host": "localhost",
        "Port": 27017,
        "Database": "rate_limits"
      },
      "Redis": {
        "Host": "localhost",
        "Port": 6379
      }
    }
  },
  "Kafka": {
    "RateLimiter": {
      "BootstrapServers": "localhost:9092",
      "Topic": "RateLimiterTopic",
      "GroupId": "RateLimiterReader"
    }
  },
  "RateLimitStatisticsOptions": {
    "Window": "00:01:00",
    "Ban": "00:05:00"
  }
}